{
  "csvfile": {
    "type": "csvfile",
    "config_class": "org.graylog2.lookup.adapters.CSVFileDataAdapter$Config",
    "default_config": {
      "type": "csvfile",
      "path": "/tmp/lookup-table.csv",
      "separator": ",",
      "quotechar": "\"",
      "key_column": "key",
      "value_column": "value",
      "check_interval": 60,
      "case_insensitive_lookup": false,
      "multi_value_lookup": false,
      "cidr_lookup": false
    }
  },
  "httpjsonpath": {
    "type": "httpjsonpath",
    "config_class": "org.graylog2.lookup.adapters.HTTPJSONPathDataAdapter$Config",
    "default_config": {
      "type": "httpjsonpath",
      "url": "https://example.invalid/api/lookup?key=${key}",
      "single_value_jsonpath": "$.value",
      "user_agent": "Graylog Lookup"
    }
  },
  "dnslookup": {
    "type": "dnslookup",
    "config_class": "org.graylog2.lookup.adapters.DnsLookupDataAdapter$Config",
    "default_config": {
      "type": "dnslookup",
      "lookup_type": "A",
      "server_ips": "",
      "request_timeout": 10000,
      "cache_ttl_override_enabled": false,
      "cache_ttl_override": null,
      "cache_ttl_override_unit": null
    }
  }
}
